{
    "id": "osmium-reviews",
    "name": "Osmium Reviews",
    "version": "0.6.0",
    "description": "Customer product reviews: a submit endpoint with spam protection, moderation in admin, and review data for the product page",
    "category": "shop",
    "author": {
        "name": "Gavin Cox"
    },
    "license": "proprietary",
    "requires": {
        "osmium": ">=1.0.0",
        "php": ">=8.1",
        "services": ["osmium-shop"]
    },
    "autoload": [
        "models"
    ],
    "migrations": "migrations/",
    "hooks": {
        "product.page.data": [
            "Osmium\\Services\\Reviews\\Models\\ReviewsHooks::productPageData"
        ],
        "mcp.tools": [
            "Osmium\\Services\\Reviews\\Models\\ReviewsMcp::tools"
        ],
        "dashboard.widgets": [
            "Osmium\\Services\\Reviews\\Models\\ReviewsHooks::dashboard"
        ],
        "email.samples": [
            "Osmium\\Services\\Reviews\\Models\\ReviewsHooks::emailSamples"
        ]
    },
    "admin": {
        "menu": {
            "section": "Shop",
            "items": [
                {
                    "id": "reviews",
                    "label": "Reviews",
                    "icon": "bx bx-star",
                    "color": "#d4a017",
                    "placement": "top",
                    "route": "admin/reviews",
                    "activePattern": "admin/reviews*",
                    "role": null
                },
                {
                    "id": "reviews-settings",
                    "label": "Reviews",
                    "icon": "bx bx-cog",
                    "route": "admin/settings/reviews",
                    "activePattern": "admin/settings/reviews",
                    "role": null
                }
            ]
        },
        "routes": {
            "admin/reviews": {
                "controller": "controllers/ReviewsController.php",
                "class": "Osmium\\Services\\Reviews\\Controllers\\ReviewsController",
                "method": "index",
                "title": "Reviews"
            },
            "admin/reviews/edit": {
                "controller": "controllers/ReviewsController.php",
                "class": "Osmium\\Services\\Reviews\\Controllers\\ReviewsController",
                "method": "edit",
                "title": "Edit Review"
            },
            "admin/reviews/action": {
                "controller": "controllers/ReviewsController.php",
                "class": "Osmium\\Services\\Reviews\\Controllers\\ReviewsController",
                "method": "action"
            },
            "admin/settings/reviews": {
                "controller": "controllers/ReviewsSettingsController.php",
                "class": "Osmium\\Services\\Reviews\\Controllers\\ReviewsSettingsController",
                "method": "index",
                "title": "Review Settings"
            }
        }
    },
    "api": {
        "routes": {
            "api/reviews": "controllers/submit.php"
        }
    },
    "setup": {
        "postInstallNote": "Reviews arrive unpublished: approve them under Shop > Reviews. Point the theme's review form (fields name, email, pid, rating, message, zip honeypot, token) at /api/reviews. The product page then gets reviews, reviewCount, ratingAverage and reviewNotice (sent or failed, shown once). Add the people to email about new reviews under Settings > Reviews."
    }
}
