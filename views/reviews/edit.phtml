<?php
$review = $admin['review'];
$selectedProduct = null;
foreach ($admin['products'] as $product) {
    $isSelected = (int) $product['id'] === $review['product_id'];
    if ($isSelected) $selectedProduct = $product;
}
$productLabel = function (array $product): string {
    $reference = (string) ($product['reference'] ?? '');

    return (string) $product['model_name'] . ($reference !== '' ? ' (' . $reference . ')' : '');
};
